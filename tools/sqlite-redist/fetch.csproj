<Project Sdk="Microsoft.NET.Sdk">
  <!-- Never built. Restored by tools/build-installer.sh only to fetch the SQLite
       files the installer ships to memoQ versions that do not have their own
       (memoQ 11). The versions are memoQ 12's own, which Supervertaler compiles
       against: Microsoft.Data.Sqlite 9.0.3, SQLitePCLRaw 2.1.10. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.3" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.10" />
  </ItemGroup>
</Project>
